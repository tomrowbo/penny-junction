OPEN_BANKING_MODE=mock
PUBLIC_BASE_URL=http://localhost:3000
STATE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Required when OPEN_BANKING_MODE=enable-banking
ENABLEBANKING_APP_ID=
ENABLEBANKING_PRIVATE_KEY=
# Or use an absolute local path instead of ENABLEBANKING_PRIVATE_KEY:
ENABLEBANKING_PRIVATE_KEY_PATH=

OPENAI_API_KEY=
# Optional: reuse OPENAI_API_KEY from another local dotenv file without copying it.
OPENAI_ENV_FILE=
OPENAI_MODEL=gpt-6-luna

# Official Junction S-Pankki dataset imported by `npm run data:setup`
SBANK_DATABASE_PATH=./data/penny.sqlite
SBANK_DEMO_CUSTOMER_ID=CUST03948
